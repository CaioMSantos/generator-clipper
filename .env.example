# Twitch Developer Console -> https://dev.twitch.tv/console/apps (app do tipo "Confidential")
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Caminhos
CLIPPER_STREAMERS_FILE=config/streamers.yaml
CLIPPER_DATA_DIR=data
# Pasta dos vídeos prontos (subpastas por data). Vazio = <CLIPPER_DATA_DIR>/output
CLIPPER_OUTPUT_DIR=

# Descoberta
CLIPPER_POLL_INTERVAL_SECONDS=120
CLIPPER_LOOKBACK_HOURS=6
CLIPPER_MIN_VIEWS=30
CLIPPER_MAX_RENDERS_PER_CYCLE=4
# Máximo por streamer em cada ciclo, em rodízio (0 = sem limite).
CLIPPER_MAX_RENDERS_PER_STREAMER=2
# Filtra clips só destes jogos (nome exato na Twitch, separados por vírgula). Vazio = sem filtro.
CLIPPER_GAME_NAMES=Grand Theft Auto VI

# Whisper (tiny|base|small|medium|large-v3). small é um bom equilíbrio em CPU.
CLIPPER_WHISPER_MODEL=small
CLIPPER_WHISPER_LANGUAGE=pt

# Título-gancho gerado por IA (caixa branca nos primeiros 4s). Sem chave, o vídeo sai sem gancho.
ANTHROPIC_API_KEY=
CLIPPER_HOOK_ENABLED=true
CLIPPER_HOOK_MODEL=claude-opus-5-5

# Fonte bold do gancho e das legendas. Coloque um .ttf aqui (ex.: Montserrat-ExtraBold.ttf);
# sem nada, cai para DejaVu Sans Bold (Docker) ou Arial Bold (Windows).
CLIPPER_FONTS_DIR=assets/fonts
